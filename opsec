#!/usr/bin/env bash
set -u

# colors 
if [ -t 1 ]; then
  R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; B=$'\e[34m'
  M=$'\e[35m'; C=$'\e[36m'; W=$'\e[97m'; D=$'\e[2m'; BOLD=$'\e[1m'; X=$'\e[0m'
else
  R= G= Y= B= M= C= W= D= BOLD= X=
fi

typ() { 
  local s=$1
  for ((i=0; i<${#s}; i++)); do printf '%s' "${s:$i:1}"; sleep 0.004; done
  printf '\n'
}

spin() { # $1 = message, $2 = seconds
  local msg=$1 dur=${2:-1} frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' end
  end=$(( $(date +%s%N)/1000000 + dur*1000 ))
  local i=0
  while [ "$(( $(date +%s%N)/1000000 ))" -lt "$end" ]; do
    printf '\r%s[%s]%s %s' "$C" "${frames:$((i%10)):1}" "$X" "$msg"
    i=$((i+1)); sleep 0.08
  done
  printf '\r%s[%s✔%s]%s %s\n' "$W" "$G" "$W" "$X" "$msg"
}

bar() { # fake apt download progress bar for $1
  local pkg=$1 w=30 j fill empty s
  for j in $(seq 0 5 100); do
    fill=$(( j*w/100 )); empty=$(( w-fill ))
    s=''
    [ "$fill"  -gt 0 ] && s=$(printf '%*s' "$fill"  '' | tr ' ' '#')
    local e='';
    [ "$empty" -gt 0 ] && e=$(printf '%*s' "$empty" '' | tr ' ' '-')
    printf '\rGet:%s %-22s%s [%s%s%s%s] %3d%%' "$W" "$pkg" "$X" "$G" "$s" "$X" "$e" "$j"
    sleep 0.03
  done
  printf '\n'
}

# setup subcommands: `opsec install` / `opsec uninstall` 
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
BIN=/usr/local/bin/opsec
HOOK_MARK="# opsec meme hook"

# pick the rc file for the user's login shell
case "$(basename "${SHELL:-bash}")" in
  zsh) RC="$HOME/.zshrc" ;;
  *)   RC="$HOME/.bashrc" ;;
esac

install_hook() {
  local rc="${1:-$RC}"
  if grep -qF "$HOOK_MARK" "$rc" 2>/dev/null; then
    echo "hook already in $rc"
  else
    cat >> "$rc" <<'HOOK'

sudo() {
  if [ "$1" = apt ] && [ "$2" = opsec ]; then command opsec; return; fi
  command sudo "$@"
}
HOOK
    echo "hook added to $rc (open a new shell to load it)"
  fi
}

case "${1:-}" in
  install)
    if [ "$SELF" != "$BIN" ]; then
      sudo install -m755 "$SELF" "$BIN" && echo "installed $BIN"
    else
      echo "already at $BIN"
    fi
    install_hook "$RC"
    echo
    echo "done. load the hook now:  source $RC   (or just open a new shell)"
    echo "then:  sudo apt opsec"
    exit 0 ;;
  uninstall)
    sudo rm -f "$BIN" && echo "removed $BIN"
    echo "note: delete the '$HOOK_MARK' block from $RC by hand"
    exit 0 ;;
  -h|--help|help)
    echo "opsec           run the gag"
    echo "opsec install   copy to $BIN + add 'sudo apt opsec' hook to ~/.bashrc"
    echo "opsec uninstall remove the binary"
    exit 0 ;;
esac

clear 2>/dev/null

